---
import type { Locale } from '../../lib/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = (es: string, en: string) => (locale === 'en' ? en : es);
---
<a class="skip" href="#contenido">{tr("Saltar al contenido", "Skip to content")}</a>
<div class="progress" aria-hidden="true"></div>
<canvas class="bg-hive" id="bgHive" aria-hidden="true"></canvas>
<div class="me" aria-hidden="true">{tr("Tú", "You")}</div>

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <!-- Avatar Hexalis "Panal abierto" (guía de identidad v1.0), versión transparente recortada al símbolo -->
    <linearGradient id="hx-face" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7A9FEB"/><stop offset="1" stop-color="#4064C6"/></linearGradient>
    <path id="hx-cell" d="M57.8 4.5 L92.2 24.4 Q100 28.9 100 37.9 L100 77.6 Q100 86.6 92.2 91.1 L57.8 111 Q50 115.5 42.2 111 L7.8 91.1 Q0 86.6 0 77.6 L0 37.9 Q0 28.9 7.8 24.4 L42.2 4.5 Q50 0 57.8 4.5Z"/>
    <symbol id="cube" viewBox="80 80 352 352">
      <use href="#hx-cell" transform="translate(143 98.46) scale(1.08)" fill="#1E3780"/><use href="#hx-cell" transform="translate(143 84.46) scale(1.08)" fill="url(#hx-face)"/>
      <use href="#hx-cell" transform="translate(261 84.46) scale(1.08)" fill="none" style="stroke: var(--logo-slot)" stroke-width="5.56" stroke-dasharray="13.89 8.33" stroke-linecap="round"/>
      <use href="#hx-cell" transform="translate(84 200.65) scale(1.08)" fill="#1E3780"/><use href="#hx-cell" transform="translate(84 186.65) scale(1.08)" fill="url(#hx-face)"/>
      <use href="#hx-cell" transform="translate(202 200.65) scale(1.08)" fill="#688BE0"/><use href="#hx-cell" transform="translate(202 186.65) scale(1.08)" fill="#F2F4FA" stroke="#688BE0" stroke-width="2.78"/>
      <use href="#hx-cell" transform="translate(320 200.65) scale(1.08)" fill="#1E3780"/><use href="#hx-cell" transform="translate(320 186.65) scale(1.08)" fill="url(#hx-face)"/>
      <use href="#hx-cell" transform="translate(143 302.84) scale(1.08)" fill="#1E3780"/><use href="#hx-cell" transform="translate(143 288.84) scale(1.08)" fill="url(#hx-face)"/>
      <use href="#hx-cell" transform="translate(261 302.84) scale(1.08)" fill="#1E3780"/><use href="#hx-cell" transform="translate(261 288.84) scale(1.08)" fill="url(#hx-face)"/>
    </symbol>
    <symbol id="arrow" viewBox="0 0 18 22"><path d="M1.5 1.5v16.2l4.3-3.9 3.1 6.7 2.9-1.3-3-6.6h5.9z" fill="var(--c)" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></symbol>
    <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <linearGradient id="hxSheen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".55" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <linearGradient id="hxRim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".7"/><stop offset=".32" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <radialGradient id="hxShadow"><stop offset="0" stop-color="#000" stop-opacity=".45"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
    <symbol id="i-go" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  </defs>
</svg>

<header class="nav" aria-label={tr("Menú", "Menu")}>
  <div class="wrap nav-in">
    <a class="logo" href="#inicio" aria-label={tr("Hexalis, inicio", "Hexalis, home")}><svg aria-hidden="true"><use href="#cube"/></svg>Hexalis <small>ORG</small></a>
    <ul class="links" aria-label={tr("Secciones", "Sections")}>
      <li><a href="#obras">{tr("Obras", "Work")}</a></li><li><a href="#playground">{tr("Prueba en vivo", "Live demo")}</a></li><li><a href="#proyectos">{tr("Proyectos", "Projects")}</a></li><li><a href="#bitacora">{tr("Bitácora", "Log")}</a></li><li><a href="#equipo">{tr("Equipo", "Team")}</a></li><li><a href="#sumate">{tr("Súmate", "Join")}</a></li>
    </ul>
    <button class="icon-btn theme-btn" type="button" aria-label={tr("Cambiar tema", "Change theme")}><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
    <a class="btn btn-primary" data-link="github" href="#">GitHub</a>
    <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="drawer" aria-label={tr("Abrir menú", "Open menu")}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg></button>
  </div>
</header>
<nav class="drawer glass" id="drawer" aria-label={tr("Menú móvil", "Mobile menu")}>
  <a href="#obras">{tr("Obras", "Work")}</a><a href="#playground">{tr("Prueba en vivo", "Live demo")}</a><a href="#proyectos">{tr("Proyectos", "Projects")}</a><a href="#bitacora">{tr("Bitácora", "Log")}</a><a href="#metodo">{tr("Método", "Method")}</a><a href="#equipo">{tr("Equipo", "Team")}</a><a href="#sumate">{tr("Súmate", "Join")}</a><a data-link="github" href="#">GitHub</a>
</nav>

<nav class="rail" id="rail" aria-label={tr("Capítulos del recorrido", "Journey chapters")}>
  <a href="#inicio"><i></i><span>{tr("La idea", "The idea")}</span></a><a href="#abierto"><i></i><span>{tr("Abierto", "Open")}</span></a><a href="#seis"><i></i><span>{tr("El equipo", "The team")}</span></a><a href="#sistema"><i></i><span>{tr("El sistema", "The system")}</span></a><a href="#metodo"><i></i><span>{tr("El método", "The method")}</span></a><a href="#space"><i></i><span>{tr("Los proyectos", "The projects")}</span></a>
</nav>
