---
import type { Locale } from '../../lib/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = (es: string, en: string) => (locale === 'en' ? en : es);
import { Picture } from 'astro:assets';
import type { ImageOutputFormat } from 'astro';
import dsDark from '../../assets/covers/ds-cover-dark.png';
import dsLight from '../../assets/covers/ds-cover-light.png';
import opsDark from '../../assets/covers/ops-cover-dark.png';
import opsLight from '../../assets/covers/ops-cover-light.png';
import btLight from '../../assets/covers/bt-cover-light.png';
/* Covers ship as AVIF/WebP in several widths; sizes follows the bento: 7 of 12 columns from 1200 px, full width below. */
const cover = { formats: ['avif'] as ImageOutputFormat[], fallbackFormat: 'webp' as ImageOutputFormat, widths: [480, 800, 1200, 1600], sizes: '(min-width: 1200px) min(58vw, 820px), calc(100vw - 32px)', loading: 'lazy' as const };
---
<section class="sec" id="obras" aria-labelledby="obrasTitle">
    <div class="wrap">
      <div class="sec-head rise">
        <h2 id="obrasTitle">{tr("Tres librerías, un mismo sistema", "Three libraries, one system")}</h2>
        <p>{tr("Una define cómo se ve, otra la estructura de cada página y otra lo documenta. Gratis, también para uso comercial.", "One sets the look, one the structure of each page and one documents it all. Free, commercial use included.")}</p>
      </div>
      <div class="bento">
        <figure class="tile cover b-ds-cover tilt rise">
          <Picture src={dsDark} class="img-dark" alt={tr("Portada de Hexalis Design System: panal de hexágonos con botones, interruptores y campos.", "Hexalis Design System cover: a honeycomb of hexagons with buttons, switches and fields.")} {...cover} />
          <Picture src={dsLight} class="img-light" alt={tr("Portada de Hexalis Design System: panal de hexágonos con botones, interruptores y campos.", "Hexalis Design System cover: a honeycomb of hexagons with buttons, switches and fields.")} {...cover} />
        </figure>
        <div class="tile info b-ds-info rise">
          <div class="tile-title"><h3>Hexalis Design System</h3><span>v2.0.0 · MIT + CC BY 4.0</span></div>
          <p class="facts-line"><span><strong>90</strong>{tr("componentes", "components")}</span><span><strong>8</strong>{tr("paletas", "palettes")}</span><span><strong>2</strong>{tr("estilos", "styles")}</span><span><strong>2</strong>{tr("temas", "themes")}</span></p>
          <p>{tr("Variables, temas y componentes: el origen de cada decisión visual. La v2 suma el estilo Arcilla junto al Neutral, y cada componente cambia de estilo sin duplicarse. Contraste WCAG 2.2 AA.", "Variables, themes and components: the source of every visual decision. v2 adds the Arcilla style next to Neutral, and every component switches style without being duplicated. WCAG 2.2 AA contrast.")}</p>
          <ol class="steps">
            <li><span><strong>{tr("Duplica", "Duplicate")}</strong> {tr("el archivo en Figma y empieza en la página Map.", "the file in Figma and start on the Map page.")}</span></li>
            <li><span><strong>{tr("Elige una paleta", "Pick a palette")}</strong> {tr("sin tocar los componentes.", "without touching the components.")}</span></li>
            <li><span><strong>{tr("Instala", "Install")}</strong> <code>@hexalis/design-system</code>{tr(": variables CSS", ": CSS variables")} <code>--hexalis-*</code> {tr("y componentes en React.", "and React components.")}</span></li>
          </ol>
          <div class="actions"><a class="btn btn-primary" data-link="dsFigma" href="#">{tr("Abrir en Figma", "Open in Figma")}</a><a class="btn btn-ghost" data-link="dsStorybook" href="#">Storybook</a><a class="btn btn-ghost" data-link="dsRepo" href="#">GitHub</a></div>
        </div>
        <div class="tile info b-ops-info rise">
          <div class="tile-title"><h3>Hexalis Design Ops Toolkit</h3><span>v1.1.0 · CC BY 4.0</span></div>
          <p class="facts-line"><span><strong>17</strong>{tr("plantillas", "templates")}</span><span><strong>6</strong>kits</span><span><strong>114</strong>{tr("componentes", "components")}</span></p>
          <p>{tr("No diseña tu producto: te da una forma consistente de investigar, anotar, documentar y entregar.", "It does not design your product: it gives you a consistent way to research, annotate, document and hand off.")}</p>
          <ol class="steps">
            <li><span><strong>{tr("Duplica", "Duplicate")}</strong> {tr("el Toolkit en Figma.", "the Toolkit in Figma.")}</span></li>
            <li><span><strong>{tr("Copia", "Copy")}</strong> {tr("la plantilla de la fase en la que estás.", "the template for the phase you are in.")}</span></li>
            <li><span><strong>{tr("Reemplaza", "Replace")}</strong> {tr("cada texto entre", "every text in")} <code>{tr("[corchetes]", "[brackets]")}</code>.</span></li>
          </ol>
          <div class="actions"><a class="btn btn-ops" data-link="opsFigma" href="#">{tr("Abrir en Figma", "Open in Figma")}</a><a class="btn btn-ghost" data-link="opsRepo" href="#">GitHub</a></div>
        </div>
        <figure class="tile cover b-ops-cover tilt rise">
          <Picture src={opsDark} class="img-dark" alt={tr("Portada de Hexalis Design Ops Toolkit: ciclo de seis fases en hexágonos, de Set up a Review.", "Hexalis Design Ops Toolkit cover: a six-phase cycle in hexagons, from Set up to Review.")} {...cover} />
          <Picture src={opsLight} class="img-light" alt={tr("Portada de Hexalis Design Ops Toolkit: ciclo de seis fases en hexágonos, de Set up a Review.", "Hexalis Design Ops Toolkit cover: a six-phase cycle in hexagons, from Set up to Review.")} {...cover} />
        </figure>
        <figure class="tile cover b-bt-cover tilt rise">
          <Picture src={btLight} alt={tr("Portada de Hexalis Blocks & Templates: bloques hexagonales con interruptores, botones, pestañas y gráficos que encajan en una plantilla.", "Hexalis Blocks & Templates cover: hexagonal blocks with switches, buttons, tabs and charts snapping into a template.")} {...cover} />
        </figure>
        <div class="tile info b-bt-info rise">
          <div class="tile-title"><h3>Hexalis Blocks &amp; Templates</h3><span>v0.2.0 · MIT + CC BY 4.0</span></div>
          <p class="facts-line"><span><strong>22</strong>{tr("plantillas web", "web templates")}</span><span><strong>14</strong>{tr("móviles", "mobile")}</span><span><strong>5</strong>{tr("tamaños de pantalla", "size classes")}</span></p>
          <p>{tr("Borrador, aún sin publicar. Empieza desde una estructura, no desde un marco vacío: plantillas de app, marketing y móvil hechas de espacios que se llenan con componentes del Design System.", "Draft, not published yet. Start from a structure, not a blank frame: app, marketing and mobile templates made of slots you fill with Design System components.")}</p>
          <ol class="steps">
            <li><span><strong>{tr("Elige", "Pick")}</strong> {tr("la plantilla más parecida a tu pantalla.", "the template closest to your screen.")}</span></li>
            <li><span><strong>{tr("Inserta", "Insert")}</strong> {tr("la variante de tu tamaño de pantalla.", "the variant for your size class.")}</span></li>
            <li><span><strong>{tr("Cambia", "Swap")}</strong> {tr("cada espacio por el componente que indica su etiqueta.", "each slot for the component its label names.")}</span></li>
          </ol>
          <div class="actions"><a class="btn btn-primary" data-link="btFigma" href="#">{tr("Abrir en Figma", "Open in Figma")}</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. PLAYGROUND -->
