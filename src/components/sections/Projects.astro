---
import type { Locale } from '../../lib/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = (es: string, en: string) => (locale === 'en' ? en : es);

/* Every project sits on the same four-step path, so a visitor reads status from one shape instead of five labels. */
const STAGES = [tr('Idea', 'Idea'), tr('Diseño', 'Design'), tr('Prototipo', 'Prototype'), tr('Disponible', 'Available')];
const TONE = ['ops', 'ds', 'warn', 'ok'];
const stageLabel = (step: number) => tr(`Etapa ${step} de 4: ${STAGES[step - 1]}`, `Step ${step} of 4: ${STAGES[step - 1]}`);

type Project = { id?: string; type: string; meta: string; name: string; text: string; step: number; cta?: { label: string; href: string; link?: string; external?: boolean }; note?: string };

const ready: Project[] = [
  { type: tr('Sistema de diseño', 'Design system'), meta: 'v2.0.0', name: 'Hexalis Design System', step: 4,
    text: tr('90 componentes en claro y oscuro, con 8 paletas y 2 estilos.', '90 components in light and dark, with 8 palettes and 2 styles.'),
    cta: { label: tr('Ver el Design System', 'See the Design System'), href: '#obras' } },
  { type: tr('Kit de documentación', 'Documentation kit'), meta: 'v1.1.0', name: 'Hexalis Design Ops Toolkit', step: 4,
    text: tr('6 kits y 17 plantillas para documentar cualquier producto.', '6 kits and 17 templates to document any product.'),
    cta: { label: tr('Ver el Toolkit', 'See the Toolkit'), href: '#obras' } },
];

const underway: Project[] = [
  { id: 'p-spaceapps', type: tr('App web', 'Web app'), meta: 'Space Apps 2026', name: 'Milanko', step: 3,
    text: tr('Convierte preguntas cotidianas sobre la Tierra, como «¿hace más calor aquí que antes?», en una investigación guiada con datos de la NASA. Hecho en Managua; su estilo, Arcilla, pasó al Design System v2.', 'Turns everyday questions about Earth, like “is it hotter here than before?”, into a guided investigation with NASA data. Made in Managua; its style, Arcilla, became part of Design System v2.'),
    cta: { label: tr('Probar Milanko', 'Try Milanko'), href: '#', link: 'spaceApps', external: true } },
  { id: 'p-blocks', type: tr('Plantillas', 'Templates'), meta: 'v0.2.0', name: 'Hexalis Blocks & Templates', step: 3,
    text: tr('Plantillas de página para web y móvil. Las de app y móvil ya usan el Design System v2; las de marketing se están convirtiendo.', 'Page templates for web and mobile. App and mobile ones already use Design System v2; marketing ones are being converted.'),
    cta: { label: tr('Ver las plantillas', 'See the templates'), href: '#obras' } },
  { id: 'p-portal', type: tr('Sitio web', 'Website'), meta: tr('Este sitio', 'This site'), name: 'Portal Hexalis', step: 2,
    text: tr('Este sitio, diseñado con nuestro propio sistema y documentado con el Toolkit.', 'This site, designed with our own system and documented with the Toolkit.'),
    note: tr('Ya estás aquí', 'You are here') },
];
---
<section class="sec" id="proyectos" aria-labelledby="projTitle">
    <div class="wrap">
      <div class="sec-head rise">
        <h2 id="projTitle">{tr("Lo que estamos construyendo", "What we are building")}</h2>
        <p>{tr("Lo que ya puedes usar, lo que viene en camino y dónde puede empezar tu idea.", "What you can use today, what is on the way and where your idea can start.")}</p>
      </div>

      <ol class="stage-key rise" aria-label={tr("Etapas de un proyecto", "Project steps")}>
        {STAGES.map((s, i) => <li data-tone={TONE[i]}><span>{i + 1}</span>{s}</li>)}
      </ol>

      <div class="board">
        {[
          { id: 'laneReady', title: tr('Listos para usar', 'Ready to use'), sub: tr('Gratis y open source. Úsalos hoy.', 'Free and open source. Use them today.'), items: ready, cols: 'two' },
          { id: 'laneWay', title: tr('En camino', 'On the way'), sub: tr('Puedes probarlos y seguir su avance.', 'Try them and follow their progress.'), items: underway, cols: 'three' },
        ].map(lane => (
          <div class="lane rise" role="group" aria-labelledby={lane.id}>
            <div class="lane-head"><h3 id={lane.id}>{lane.title}</h3><span class="lane-count">{lane.items.length}</span><p>{lane.sub}</p></div>
            <div class={`lane-grid ${lane.cols}`}>
              {lane.items.map(p => (
                <article class="pcard" id={p.id} data-tone={TONE[p.step - 1]}>
                  <div class="pcard-top"><span class="ptype">{p.type}</span><span class="pmeta">{p.meta}</span></div>
                  <h4>{p.name}</h4>
                  <p>{p.text}</p>
                  <div class="pstage" role="img" aria-label={stageLabel(p.step)}>
                    <span class="pstage-bar" aria-hidden="true">{[1, 2, 3, 4].map(n => <i class={n <= p.step ? 'on' : ''}></i>)}</span>
                    <b aria-hidden="true">{STAGES[p.step - 1]}</b>
                  </div>
                  {p.cta
                    ? <a class="more" href={p.cta.href} data-link={p.cta.link}>{p.cta.label} <span class="arr" aria-hidden="true">{p.cta.external ? '↗' : '→'}</span></a>
                    : <span class="here">{p.note}</span>}
                </article>
              ))}
            </div>
          </div>
        ))}

        <div class="lane open rise" role="group" aria-labelledby="laneNext">
          <a class="pcard slot" id="p-next" href="#sumate">
            <svg class="slot-hex" viewBox="0 0 104 120" aria-hidden="true"><path class="slot-line" d="M59.6 8.4 L92.9 27.6 Q100.5 32.0 100.5 40.7 L100.5 79.3 Q100.5 88.0 92.9 92.4 L59.6 111.6 Q52.0 116.0 44.4 111.6 L11.1 92.4 Q3.5 88.0 3.5 79.3 L3.5 40.7 Q3.5 32.0 11.1 27.6 L44.4 8.4 Q52.0 4.0 59.6 8.4Z"/></svg>
            <div class="slot-copy">
              <span class="ptype">{tr("Etapa 1: Idea", "Step 1: Idea")}</span>
              <h3 id="laneNext">{tr("Tu proyecto puede ser el siguiente", "Your project could be next")}</h3>
              <p>{tr("¿Tienes una idea útil para la comunidad? Proponla y la construimos juntos, como open source.", "Have an idea that helps the community? Propose it and we will build it together, as open source.")}</p>
            </div>
            <span class="btn btn-ops">{tr("Proponer una idea", "Propose an idea")} <span class="arr" aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. BITÁCORA -->
