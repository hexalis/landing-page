---
import type { Locale } from '../../lib/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = (es: string, en: string) => (locale === 'en' ? en : es);
---
<section class="sec" id="equipo" aria-labelledby="teamTitle">
    <div class="wrap">
      <div class="sec-head rise">
        <h2 id="teamTitle">{tr("Las personas detrás de cada celda", "The people behind every cell")}</h2>
        <p>{tr("Seis personas de diseño y desarrollo. Cada color es alguien del equipo; la celda del centro te espera.", "Six people in design and development. Each colour is someone on the team; the centre cell is waiting for you.")}</p>
      </div>
      <div class="team-wrap rise"><div class="team hive" id="team" aria-label={tr("El equipo: elige una celda", "The team: pick a cell")}></div><div class="hive-side"><div class="hive-card" id="teamCard" aria-live="polite"></div><p class="hive-hint">{tr("Elige otra celda para conocer al equipo.", "Pick another cell to meet the team.")}</p></div></div>
      <div class="contrib" id="contrib" hidden><span class="label">{tr("También en GitHub", "Also on GitHub")}</span><div class="contrib-faces" id="contribFaces"></div></div>
    </div>
  </section>
