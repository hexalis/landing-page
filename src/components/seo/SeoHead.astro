---
import { localizedPath, locales, type Locale } from '../../lib/routes';
interface Props { title: string; description: string; shareDescription: string; locale: Locale; path?: string; noindex?: boolean }
const { title, description, shareDescription, locale, path = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const placeholder = Astro.site?.hostname === 'example.com';
const ogImage = new URL('/assets/og.png', Astro.site);
const schema = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Hexalis', description, url: new URL('/', Astro.site).href, sameAs: ['https://github.com/hexalis'] };
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex || placeholder ? 'noindex, follow' : 'index, follow'} />
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && locales.map((lang) => <link rel="alternate" hreflang={lang} href={new URL(localizedPath(lang, path), Astro.site)} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('es', path), Astro.site)} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={shareDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '<')} />
